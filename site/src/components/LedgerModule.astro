---
import Inline from './Inline.astro';

interface LedgerRow {
  term: string;
  detail: string;
  tone: 'affirm' | 'deny';
}
interface Props {
  rows: LedgerRow[];
}
const { rows } = Astro.props;
---

<dl class="ledger">
  {
    rows.map((row) => (
      <div class="row" data-tone={row.tone}>
        <dt>
          <span class="sigil" aria-hidden="true">{row.tone === 'affirm' ? '+' : '–'}</span>
          <span class="state">{row.tone === 'affirm' ? 'It does' : 'It does not'}</span>
          <span class="term">{row.term}</span>
        </dt>
        <dd><Inline text={row.detail} /></dd>
      </div>
    ))
  }
</dl>

<style>
  .ledger {
    display: grid;
    border-block-start: 1px solid var(--line);
  }

  .row[data-tone='deny'] {
    background: var(--bg-sunken);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
    gap: var(--s-3) var(--s-5);
    padding: var(--s-4) var(--s-4) var(--s-4) 0;
    border-block-end: 1px solid var(--line);
  }

  .row[data-tone='deny'] {
    padding-inline-start: var(--s-4);
    margin-inline-start: calc(var(--s-4) * -1);
  }

  dt {
    display: grid;
    grid-template-columns: 1.25rem minmax(0, 1fr);
    row-gap: 0.15rem;
    column-gap: 0.5rem;
    align-content: start;
  }

  .sigil {
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    inline-size: 1.25rem;
    block-size: 1.25rem;
    margin-block-start: 0.15rem;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: var(--step--2);
    font-weight: 700;
    line-height: 1;
  }

  [data-tone='affirm'] .sigil {
    background: var(--accent-wash);
    color: var(--accent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 35%, transparent);
  }

  [data-tone='deny'] .sigil {
    background: var(--bg-inset);
    color: var(--faint);
    box-shadow: inset 0 0 0 1px var(--line-strong);
  }

  .state {
    font-family: var(--mono);
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .term {
    font-family: var(--mono);
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  [data-tone='deny'] .term {
    color: var(--muted);
  }

  dd {
    margin: 0;
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.65;
    max-inline-size: 62ch;
  }

  dd :global(code) {
    font-size: 0.92em;
    color: var(--text);
    background: var(--bg-inset);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.05em 0.32em;
    overflow-wrap: anywhere;
  }

  @media (max-width: 52rem) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-2);
    }
  }
</style>
