---
import Wordmark from './Wordmark.astro';
import { getRepoFacts } from '../lib/repo-facts.node.ts';
import { SITE_TAGLINE, docUrl } from '../lib/site.ts';

interface Props {
  analyticsConfigured: boolean;
}
const { analyticsConfigured } = Astro.props;

const facts = getRepoFacts();
const year = new Date().getUTCFullYear();

const columns = [
  {
    title: 'Project',
    links: [
      { label: 'Source', href: facts.repositoryUrl, external: true },
      { label: 'Skill', href: docUrl(facts.repositoryUrl, 'SKILL.md'), external: true },
      { label: 'Changelog', href: docUrl(facts.repositoryUrl, 'CHANGELOG.md'), external: true },
      { label: 'Roadmap', href: docUrl(facts.repositoryUrl, 'ROADMAP.md'), external: true },
    ],
  },
  {
    title: 'Participate',
    links: [
      { label: 'Contributing guide', href: docUrl(facts.repositoryUrl, 'CONTRIBUTING.md'), external: true },
      { label: 'Code of Conduct', href: docUrl(facts.repositoryUrl, 'CODE_OF_CONDUCT.md'), external: true },
      { label: 'Report an issue', href: facts.issuesUrl, external: true },
      { label: 'Email support', href: 'mailto:support@thebkapp.co' },
      { label: 'Security policy', href: docUrl(facts.repositoryUrl, 'SECURITY.md'), external: true },
      {
        label: 'Report a vulnerability',
        href: `${facts.repositoryUrl}/security/advisories/new`,
        external: true,
      },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Terms of Service', href: '/terms' },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'MIT License', href: docUrl(facts.repositoryUrl, 'LICENSE'), external: true },
    ],
  },
];
---

<footer class="site-footer">
  <div class="shell">
    <div class="grid">
      <div class="identity">
        <Wordmark />
        <p>{SITE_TAGLINE}</p>
        <p class="pins">
          <span>v{facts.packageVersion}</span>
          <span class="verified">
            <span class="pill" tabindex="0" aria-describedby="verified-tip">
              <svg viewBox="0 0 16 16" width="11" height="11" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m3 8.5 3 3 7-7" />
              </svg>
              verified {facts.pins.verifiedDate}
            </span>
            <span class="tip" role="tooltip" id="verified-tip">
              Last verified on {facts.pins.verifiedDate} with Codex app-server
              {facts.pins.verifiedCodexRuntime.replace('app-server ', '')} (supported
              {facts.pins.supportedCodexRuntime.replace('app-server ', '')}), Claude Code
              {facts.pins.verifiedClaudeCli}, Claude Desktop {facts.pins.verifiedClaudeDesktop},
              {facts.pins.verifiedCodexMobile}, and {facts.pins.verifiedClaudeMobile}.
              Codex Desktop: {facts.pins.verifiedCodexDesktop}.
            </span>
          </span>
        </p>
      </div>

      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2>{column.title}</h2>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...(link.external ? { rel: 'noopener noreferrer external' } : {})}
                  >
                    {link.label}
                    {link.external && <span class="sr-only"> (opens on github.com)</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div class="baseline">
      <p>
        © {year}
        <a href="https://thebkapp.co" rel="noopener noreferrer external">The Brooklyn App Company</a>.
        Released under the
        <a href={docUrl(facts.repositoryUrl, 'LICENSE')} rel="noopener noreferrer external">MIT License</a>.
      </p>
      <p class="privacy-control">
        <a
          href="/privacy#analytics"
          data-privacy-choices={analyticsConfigured ? '' : undefined}
          aria-describedby={analyticsConfigured ? 'privacy-state' : undefined}
        >
          Privacy choices
        </a>
        <span id="privacy-state" data-privacy-state role="status" aria-live="off" />
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--s-7);
    border-block-start: 1px solid var(--line);
    background: var(--bg-sunken);
    padding-block: var(--s-7) var(--s-6);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
  }

  .identity p {
    margin-block-start: var(--s-3);
    color: var(--muted);
    font-size: var(--step--1);
    max-inline-size: 38ch;
  }

  .identity .pins {
    font-family: var(--mono);
    font-size: var(--step--2);
    color: var(--faint);
    letter-spacing: 0.04em;
    /* Wider than the tagline measure so the version line stays on one row;
       if it ever has to break it breaks between segments, never inside one. */
    max-inline-size: none;
  }

  .pins {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }

  .pins > span {
    white-space: nowrap;
  }

  .verified {
    position: relative;
    display: inline-flex;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 40%, transparent);
    background: var(--accent-wash);
    color: var(--accent);
    cursor: default;
  }

  .pill:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* A CSS-only tooltip: shown on hover and on keyboard focus, described to
     assistive technology through aria-describedby whether or not it is shown. */
  .tip {
    position: absolute;
    inset-block-end: calc(100% + 0.55rem);
    inset-inline-start: 0;
    z-index: 2;
    inline-size: 24rem;
    max-inline-size: min(24rem, 80vw);
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: var(--shadow);
    color: var(--muted);
    font-family: var(--sans);
    font-size: var(--step--1);
    letter-spacing: normal;
    line-height: 1.5;
    white-space: normal;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-1) var(--ease),
      visibility var(--dur-1) var(--ease);
  }

  .verified:hover .tip,
  .verified:focus-within .tip {
    opacity: 1;
    visibility: visible;
  }

  @media (prefers-reduced-motion: reduce) {
    .tip {
      transition: none;
    }
  }

  h2 {
    font-size: var(--step--2);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    margin-block-end: var(--s-3);
  }

  ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .grid a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.25rem;
    color: var(--muted);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .grid a:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .baseline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
    padding-block-start: var(--s-4);
    border-block-start: 1px solid var(--line);
    color: var(--faint);
    font-size: var(--step--2);
    font-family: var(--mono);
    letter-spacing: 0.03em;
  }

  .baseline p {
    margin: 0;
  }

  .privacy-control {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    flex-wrap: wrap;
  }

  .privacy-control button,
  .privacy-control a {
    background: none;
    border: 0;
    padding: 0.35rem 0;
    min-block-size: 2rem;
    font: inherit;
    color: var(--muted);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .privacy-control button:hover,
  .privacy-control a:hover {
    color: var(--accent);
  }

  [data-privacy-state]:not(:empty)::before {
    content: '· ';
  }

  @media (max-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .identity {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34rem) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
