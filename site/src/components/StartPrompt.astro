---
import { START_PROMPT } from '../lib/start-prompt.ts';
---

<div class="prompt" data-copy-root>
  <div class="prompt-head">
    <span class="tag">
      <span class="pip" aria-hidden="true"></span>
      Start prompt
    </span>
    <span class="hint">paste into Claude Code or Codex</span>
    <button type="button" class="copy" data-copy-button data-copy-target="start-prompt">
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="5.25" y="5.25" width="8.5" height="8.5" rx="1.75" />
        <path d="M10.75 3.25A1.5 1.5 0 0 0 9.25 2.25H3.75a1.5 1.5 0 0 0-1.5 1.5v5.5a1.5 1.5 0 0 0 1 1.41" stroke-linecap="round" />
      </svg>
      <span data-copy-label>Copy prompt</span>
    </button>
  </div>

  <pre id="start-prompt" tabindex="0" role="region" aria-label="Start prompt, selectable text">{START_PROMPT}</pre>

</div>

<!-- Announced on copy; also renders the manual-selection fallback message. -->
<p class="copy-status" data-copy-status role="status" aria-live="polite"></p>

<style>
  .prompt {
    inline-size: min(60rem, 100%);
    margin-inline: auto;
    text-align: start;
    background: var(--bg-sunken);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .prompt-head {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 0.55rem 0.6rem 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg-inset);
    font-family: var(--mono);
    font-size: var(--step--2);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
    font-weight: 600;
    flex: none;
  }

  .pip {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }

  .hint {
    color: var(--faint);
    flex: 1;
    min-inline-size: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: none;
    min-block-size: 2.25rem;
    padding: 0.3rem 0.85rem;
    background: var(--accent);
    color: var(--accent-ink);
    border: 1px solid transparent;
    border-radius: var(--radius);
    font-family: var(--mono);
    font-size: var(--step--2);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    transition: filter 120ms ease, transform 120ms ease;
  }

  .copy:hover {
    filter: brightness(1.08);
  }

  .copy:active {
    transform: translateY(1px);
  }

  .copy[data-state='copied'] {
    background: transparent;
    color: var(--accent);
    border-color: var(--accent);
  }

  /* Without JavaScript the button cannot copy anything, so it is removed and
     the prompt below remains selectable text. */
  :global(html.no-js) .copy {
    display: none;
  }

  pre {
    margin: 0;
    padding: clamp(0.95rem, 2.4vw, 1.6rem);
    font-size: clamp(0.75rem, 0.66rem + 0.38vw, 0.875rem);
    line-height: 1.7;
    color: var(--text);
    /* Wrap rather than scroll: the one-line bootstrap stays selectable at every
       width and never requires a horizontal gesture. */
    white-space: pre-wrap;
    overflow-wrap: break-word;
    tab-size: 2;
  }

  @media (max-width: 30rem) {
    pre {
      font-size: 0.75rem;
      line-height: 1.7;
    }
  }

  pre:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }


  .copy-status {
    margin: var(--s-3) 0 0;
    min-block-size: 1.4em;
    font-family: var(--mono);
    font-size: var(--step--2);
    letter-spacing: 0.06em;
    color: var(--accent);
    text-align: center;
  }

  .copy-status[data-tone='error'] {
    color: var(--warn);
  }

  @media (max-width: 34rem) {
    .prompt-head {
      flex-wrap: wrap;
    }

    .hint {
      order: 3;
      flex-basis: 100%;
      white-space: normal;
    }

    .copy {
      margin-inline-start: auto;
    }
  }
</style>
