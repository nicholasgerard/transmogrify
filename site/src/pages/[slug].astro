---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import { LEGAL_EFFECTIVE_DATE } from '../lib/site.ts';

export const getStaticPaths = (async () => {
  const entries = await getCollection('legal');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

/**
 * The two legal documents must always carry the same effective date as the one
 * the site advertises; a mismatch is a content bug, not a rendering detail.
 */
if (entry.data.effectiveDate !== LEGAL_EFFECTIVE_DATE) {
  throw new Error(
    `${entry.id}.md effectiveDate (${entry.data.effectiveDate}) does not match LEGAL_EFFECTIVE_DATE (${LEGAL_EFFECTIVE_DATE}).`,
  );
}

const displayDate = new Date(`${entry.data.effectiveDate}T00:00:00Z`).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const siblings = (await getCollection('legal')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="shell legal">
    <header>
      <p class="eyebrow">Legal</p>
      <h1>{entry.data.title}</h1>
      <p class="summary">{entry.data.summary}</p>
      <p class="meta">
        Effective <time datetime={entry.data.effectiveDate}>{displayDate}</time>
      </p>
    </header>

    <div class="prose legal-body">
      <Content />
    </div>

    <nav class="siblings" aria-label="Legal documents">
      {
        siblings
          .filter((doc) => doc.id !== entry.id)
          .map((doc) => (
            <a href={`/${doc.id}`}>
              Read the {doc.data.title}
              <span aria-hidden="true"> →</span>
            </a>
          ))
      }
      <a href="/">Back to the home page</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .legal {
    max-inline-size: 52rem;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  header {
    padding-block-end: var(--s-6);
    border-block-end: 1px solid var(--line);
  }

  h1 {
    font-size: var(--step-3);
    margin-block: var(--s-3) var(--s-4);
    letter-spacing: -0.03em;
  }

  .summary {
    color: var(--muted);
    font-size: var(--step-1);
    line-height: 1.6;
    max-inline-size: 60ch;
  }

  .meta {
    margin-block-start: var(--s-4);
    font-family: var(--mono);
    font-size: var(--step--2);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .legal-body {
    max-inline-size: none;
    padding-block-start: var(--s-5);
  }

  .legal-body :global(h2) {
    font-size: var(--step-1);
    letter-spacing: -0.015em;
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--line);
  }

  .legal-body :global(h2:first-of-type) {
    padding-block-start: 0;
    border-block-start: 0;
    margin-block-start: var(--s-4);
  }

  .legal-body :global(h3) {
    font-size: var(--step-0);
    margin-block-start: var(--s-5);
  }

  .legal-body :global(ul),
  .legal-body :global(ol) {
    display: grid;
    gap: var(--s-2);
  }

  .legal-body :global(table) {
    inline-size: 100%;
    display: block;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }

  .legal-body :global(th),
  .legal-body :global(td) {
    text-align: start;
    vertical-align: top;
    padding: var(--s-3);
    border-block-end: 1px solid var(--line);
  }

  .legal-body :global(th) {
    background: var(--bg-inset);
    font-family: var(--mono);
    font-size: var(--step--2);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    white-space: nowrap;
  }

  .legal-body :global(tbody tr:last-child th),
  .legal-body :global(tbody tr:last-child td) {
    border-block-end: 0;
  }

  .legal-body :global(td:first-child) {
    font-family: var(--mono);
    color: var(--text);
    overflow-wrap: anywhere;
  }

  .siblings {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-5);
    margin-block-start: var(--s-7);
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--line);
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .siblings a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.5rem;
    color: var(--muted);
    text-decoration: none;
    border-block-end: 1px solid var(--line-strong);
  }

  .siblings a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
