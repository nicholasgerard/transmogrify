---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRepoFacts } from '../lib/repo-facts.node.ts';
import { docUrl } from '../lib/site.ts';

const facts = getRepoFacts();

const destinations = [
  { label: 'Home', detail: 'The start prompt and the compatibility matrix.', href: '/' },
  { label: 'Install and start', detail: 'What the prompt actually runs.', href: '/#install' },
  {
    label: 'Operator skill',
    detail: 'SKILL.md — the executable policy an agent loads.',
    href: docUrl(facts.repositoryUrl, 'SKILL.md'),
    external: true,
  },
  {
    label: 'Source',
    detail: 'The repository, issues, and release history.',
    href: facts.repositoryUrl,
    external: true,
  },
];
---

<BaseLayout
  title="Page not found"
  description="That address does not resolve on transmogrify.sh. Jump to the start prompt, the install steps, the operator skill, or the source repository."
  noindex
>
  <section class="shell notfound" aria-labelledby="nf-title">
    <p class="code" aria-hidden="true">404</p>
    <h1 id="nf-title">No lane at that address.</h1>
    <p class="lede">
      That page does not exist here. Nothing has been mutated and nothing was
      adopted by name — the URL simply did not resolve.
    </p>

    <ul class="destinations">
      {
        destinations.map((item) => (
          <li>
            <a href={item.href} {...(item.external ? { rel: 'noopener noreferrer external' } : {})}>
              <span class="label">
                {item.label}
                {item.external && <span class="sr-only"> (opens on github.com)</span>}
              </span>
              <span class="detail">{item.detail}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<style>
  .notfound {
    max-inline-size: 44rem;
    padding-block: clamp(3rem, 10vw, 7rem) 0;
  }

  .code {
    font-family: var(--mono);
    font-size: var(--step--1);
    letter-spacing: 0.3em;
    color: var(--accent);
    margin-block-end: var(--s-4);
  }

  h1 {
    font-size: var(--step-3);
    letter-spacing: -0.03em;
    margin-block-end: var(--s-4);
  }

  .destinations {
    list-style: none;
    padding: 0;
    display: grid;
    margin-block-start: var(--s-6);
    border-block-start: 1px solid var(--line);
  }

  .destinations a {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: var(--s-2) var(--s-4);
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--line);
    text-decoration: none;
  }

  .destinations a:hover {
    color: inherit;
  }

  .label {
    font-family: var(--mono);
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--text);
  }

  .destinations a:hover .label {
    color: var(--accent);
  }

  .detail {
    color: var(--muted);
    font-size: var(--step--1);
  }

  @media (max-width: 34rem) {
    .destinations a {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.2rem;
    }
  }
</style>
