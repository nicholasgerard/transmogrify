{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "transmogrify-site",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "transmogrify.sh",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
